# Адрес сайта задаётся переменной SITE_ADDRESS (см. .env / docker-compose.yml).
#   - не задана           → HTTP на :80 (по IP сервера, без TLS) — как сейчас;
#   - SITE_ADDRESS=домен  → Caddy сам выпустит и продлит TLS (Let's Encrypt).
# Нужны A-запись домена на IP VDS и открытые порты 80 и 443.
#
# ВАЖНО (пресейв): band.link при финализации пресейва через свой шлюз
# (Яндекс / VK / КИОН) принимает redirectUrl ТОЛЬКО как публичный HTTPS-URL с
# доменом — на http / localhost / голом IP он отдаёт ERROR_1009. Поэтому для
# рабочего пресейв-детекта по этим сервисам нужен именно домен + HTTPS.
# (Spotify идёт мимо шлюза и работает и без домена.)
{$SITE_ADDRESS::80} {
    reverse_proxy app:8000
}
